# OKX API Configuration
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# Server
HOST=0.0.0.0
PORT=8037

# Database (SQLite)
# Default path: /data/btc_future.db (for Docker)
# For local development, use: ./data/btc_future.db
DATABASE_PATH=/data/btc_future.db

# Logging
LOG_LEVEL=INFO

# CORS
CORS_ALLOW_ORIGINS=*
